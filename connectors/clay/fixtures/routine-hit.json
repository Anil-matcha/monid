{
    "name": "routine-hit",
    "description": "The canonical happy enrichment run: start parks RUNNING on a 202 routine_run_id, one still-running 202 poll tick, then a 200 whose single item completed with a NON-EMPTY result. Settles the hit lines (enrichment_credits/enrichment_actions = 1) at the doc's own per-run rates. Minimal shared chain (fixture strategy v2) — {{request.url}}/{{request.origin}} bind it to whichever endpoint is under test; recorded live 2026-09-16 against clay#enrichment/company-domain, with the 202 tick spliced from the work-email recording and the run id normalized.",
    "calls": [
        {
            "req": { "method": "POST", "url": "{{request.url}}" },
            "res": {
                "status": 202,
                "body": {
                    "routine_run_id": "RUN1",
                    "status": "in_progress"
                }
            }
        },
        {
            "req": {
                "method": "GET",
                "url": "{{request.origin}}/public/v0/routines/run/RUN1/results?limit=100"
            },
            "res": {
                "status": 202,
                "body": {
                    "routine_run_id": "RUN1",
                    "status": "in_progress",
                    "total": 1,
                    "finished": 0
                }
            }
        },
        {
            "req": {
                "method": "GET",
                "url": "{{request.origin}}/public/v0/routines/run/RUN1/results?limit=100"
            },
            "res": {
                "status": 200,
                "body": {
                    "routine_run_id": "RUN1",
                    "status": "complete",
                    "total": 1,
                    "finished": 1,
                    "data": [
                        {
                            "id": "item-1",
                            "status": "complete",
                            "result": { "Domain": "anthropic.com" }
                        }
                    ]
                }
            }
        }
    ]
}
